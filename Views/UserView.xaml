<UserControl x:Class="LibraryApp.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibraryApp.Views"
             xmlns:components="clr-namespace:LibraryApp.Components"
             xmlns:vm="clr-namespace:LibraryApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">


        <Grid HorizontalAlignment="Left" Width="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <!-- Titre -->
                <RowDefinition Height="19*"/>
                <!-- Infos utilisateurs -->
                <RowDefinition Height="auto" MinHeight="276"/>
                <!-- Liste des utilisateurs -->

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10">
                <TextBlock 
                    Text="Utilisateurs"
                    FontSize="20"
                    FontWeight="SemiBold"
                />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                
                <components:StatCard 
                    MaxWidth="180" 
                    Grid.Column="0" 
                    Title="Total Membres" 
                    Value="120" 
                    BackgroundColor="#F5AF91"
                    Icon="pack://application:,,,/LibraryApp;component/Ressources/Assets/Users.png" Loaded="StatCard_Loaded"
                />
                <components:StatCard 
                    MaxWidth="200" 
                    Grid.Column="1" 
                    Title="Nouveaux membres" 
                    Value="120" 
                    BackgroundColor="#6f382ac7"
                    Icon="/Ressources/Assets/user-plus-solid.png"
                />
                <components:StatCard 
                    MaxWidth="180" 
                    Grid.Column="2" 
                    Title="Membres actifs" 
                    Value="120" 
                    BackgroundColor="#C288C2"
                    Icon="pack://application:,,,/LibraryApp;component/Ressources/Assets/Star.png"
                />
                <components:StatCard 
                    MaxWidth="180" 
                    Grid.Column="3" 
                    Title="Membres inactifs" 
                    Value="120" 
                    BackgroundColor="#47A1AB"
                    Icon="pack://application:,,,/LibraryApp;component/Ressources/Assets/people-robbery-solid.png"
                    
                />
            </Grid>

            <Grid Grid.Row="2" Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 🔍 SEARCH BAR -->
                <Border Grid.Row="0"
            Background="#F5F5F5"
            CornerRadius="10"
            Padding="10"
            Margin="0,0,0,10">

                    <TextBox 
            Background="Transparent"
            BorderThickness="0"
            FontSize="14"
            Foreground="Black"
            Text="Rechercher..."
            />
                </Border>

                <!-- 📊 DATAGRID -->
                <DataGrid Grid.Row="1"
              ItemsSource="{Binding Users}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              GridLinesVisibility="None"
              RowBackground="White"
              AlternatingRowBackground="#FAFAFA"
              BorderThickness="0"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              CanUserResizeRows="False"
              CanUserAddRows="False"
              Margin="0"
              FontSize="13">

                    <!-- STYLE GLOBAL -->
                    <DataGrid.Resources>

                        <!-- HEADER -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#666"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>

                        <!-- ROW -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="45"/>
                            <Setter Property="Margin" Value="0,5"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>

                            <Style.Triggers>
                                <!-- Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F8FF"/>
                                </Trigger>

                                <!-- Selected -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6F0FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </DataGrid.Resources>

                    <!-- COLONNES -->
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="2*"/>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="Actions" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <!-- Modifier -->
                                        <Border Background="#E3F2FD"
                                    CornerRadius="5"
                                    Margin="5">
                                            <Button Content="Modifier"
                                        Background="Red"
                                        BorderThickness="0"
                                        Padding="5,2"/>
                                        </Border>

                                        <!-- Supprimer -->
                                        <Border Background="#FFEBEE"
                                    CornerRadius="5"
                                    Margin="5">
                                            <Button Content="Supprimer"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="Red"
                                        Padding="5,2"/>
                                        </Border>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
