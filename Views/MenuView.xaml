<UserControl x:Class="LibraryApp.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibraryApp.Views"
             xmlns:components="clr-namespace:LibraryApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Border 
                Background="#003054"
                
            >
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Logo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Profil -->
                        <RowDefinition Height="*"/>
                        <!-- Navigation -->
                        <RowDefinition Height="Auto"/>
                        <!-- Logout -->
                    </Grid.RowDefinitions>

                    <!--  Logo -->
                    <StackPanel Grid.Row="0" Margin="10">
                        <TextBlock Text="Lima" Foreground="White" FontSize="20"/>
                    </StackPanel>

                    <!--  Profil -->
                    <StackPanel 
                        Grid.Row="1" 
                        Margin="10"
                        HorizontalAlignment="Center"
                    >
                        <Image 
                            Source="pack://application:,,,/LibraryApp;component/Ressources/Assets/ppBiblio.png"
                            Width="80"
                        />
                        <TextBlock 
                            Text="Ariane" 
                            Foreground="White"
                            HorizontalAlignment="Center"
                        />
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2">
                        <components:MenuButton 
                            Text="Dashboard"
                            Icon="pack://application:,,,/LibraryApp;component/Ressources/Assets/ChartLineSolid.png"
                        
                            Margin="0,10,0,10"
                        
                        />
                        <components:MenuButton 
                            Text="Membres"
                            Icon="pack://application:,,/LibraryApp;component/Ressources/Assets/UserRegular.png"

                            Margin="0,0,0,10"
                        />
                        <components:MenuButton 
                            Text="Livres"
                            Icon="pack://application:,,,/LibraryApp;component/Ressources/Assets/BookSolid.png"

                            Margin="0,0,0,10"
                        />
                        <components:MenuButton 
                            Text="Emprunts"
                            Icon="pack://application:,,,/LibraryApp;component/Ressources/Assets/LineLeaningSolid.png"
                        />
                    </StackPanel>

                    <!-- Logout -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image 
                            Source="pack://application:,,,/LibraryApp;component/Ressources/Assets/Logout.png"
                            Width="20"
                        />
                        <Button 
                            Content="Déconnexion"
                            Margin="10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                        />
                    </StackPanel>

                </Grid>


            </Border>
        
        </Grid>
    </Grid>
</UserControl>
