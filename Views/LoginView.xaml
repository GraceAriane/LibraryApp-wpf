<UserControl x:Class="LibraryApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibraryApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid 
        Background="White" 
    >

        <!-- Définition des colonnes -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <!-- colonne gauche (contenu) -->
            <ColumnDefinition Width="3*" />
            <!-- colonne droite (image) -->
        </Grid.ColumnDefinitions>


        <!-- Coté formulaire -->
        <Border
            HorizontalAlignment="center"
            VerticalAlignment="center"
            Padding="15"
        >
            
            <Grid
               Height="350"
            >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock 
                    Text="Bienvenue !" 
                    FontSize="24" 
                    FontWeight="Bold" 
                    HorizontalAlignment="Center"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    
                />
                
                <TextBlock 
                    Text="Let's discover how we can help you design workspace for your team" 
                    FontSize="12" 
                    Padding="5"
                    Grid.Row="1"
                    Margin="0,0,0,10"
                />
                
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="center"
                >
                    <Border 
                        CornerRadius="8" 
                        Background="#F0F0F0" 
                        Padding="2"
                        Height="40"
                        Margin="0,20,0,15"
                    >
                        <TextBox 
                            Width="280" 
                            Height="35"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="5"
                            
                        />
                    </Border>
                    
                    <Border 
                        CornerRadius="8" 
                        Background="#F0F0F0" 
                        Padding="2"
                        Height="40"
                        Margin="0,0,0,15"
                    >
                        <PasswordBox 
                            Width="280" 
                            Height="35"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="5"
                        />
                    </Border>
                    
                    <TextBlock 
                        Text="Mot de passe oublié ?" 
                        Foreground="Blue" 
                        HorizontalAlignment="Right" 
                        Cursor="Hand"
                        Margin="0,0,0,20"
                        FontSize="12"
                    />

                    <Border
                        Background="#F47631"
                        CornerRadius="15"
                    >
                        <Button 
                            Content="Se connecter"
                            Command="{Binding LoginCommand}"
                            Padding="4"
                            Foreground="white"
                            Background="#F47631"
                            BorderThickness="0"
                            FontSize="12"
                            Margin="5"
                        />

                    </Border>



                </StackPanel>


            </Grid>
       </Border>

        <!-- Image -->
        <Border 
            Grid.Column="1"
            Background="#02598B"
            Margin="10"
            CornerRadius="20"
            
        >
            <Image Source="pack://application:,,,/Ressources/Assets/ImageLogin.png" Stretch="UniformToFill" Width="350" Height="350"/>
        </Border>
        
        
        
        <!--
            #FAFAFA content background
            #E8F1F3 sidebar background
            #47A1AB turquoise
        
            #484848 couleur pour le texte
            #C0278F violet rose
            #46A82A vert
            #BD288F violet
        
            #E9F5FF bleu très clair
            #F5F5F0 gris clair
            #832FC2 violet
        
            #F47631 orange bouton
            #F4B317 orange
            #003054 bleu très foncé
            #02598B bleu nuit
            #67CAD4 bleu clair
            #F1F5F9 gris clair
        -->


    </Grid>
</UserControl>
