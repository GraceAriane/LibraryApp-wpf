<UserControl x:Class="LibraryApp.Components.MenuButton"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibraryApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Width="155" Height="45">
        <Border CornerRadius="10" Background="#F47631" Padding="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Icône -->
                <Image Source="{Binding Icon, ElementName=root}" 
                   Width="20" Height="20" Margin="0,0,10,0"/>

                <!-- Texte -->
                <TextBlock Text="{Binding Text, ElementName=root}" 
                       Foreground="White"
                       VerticalAlignment="Center"
                       FontSize="14"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
